{
  "expo": {
    "name": "Resonance Mobile",
    "slug": "resonance-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "resonance-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Resonance uses the camera for the world-space AR view that anchors resonators in your surroundings.",
        "NSMicrophoneUsageDescription": "Resonance uses the microphone for AR session audio features."
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b35a6559-e14e-4256-832a-d31c41a952f1"
      }
    },
    "owner": "nexus.system",
    "updates": {
      "url": "https://u.expo.dev/b35a6559-e14e-4256-832a-d31c41a952f1",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}